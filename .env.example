# freebuff-router configuration
# Copy this file to .env and adjust the values as needed:
#   cp .env.example .env
# The service loads .env automatically from the working directory.

# --- Server -----------------------------------------------------------------
# Listen address
#HOST=127.0.0.1
# Listen port
#PORT=20130

# --- Persistence -------------------------------------------------------------
# Single SQLite database file (hot state + request history)
#SQLITE_PATH=freebuffrouter.db

# --- Auth / dashboard --------------------------------------------------------
# File containing gateway API keys (one per line). On first boot an admin
# key is auto-generated and written to this file (default: bootstrap-key.txt)
#GATEWAY_KEY_FILE=bootstrap-key.txt
# Comma or newline separated gateway keys used as bootstrap when DB is empty
#GATEWAY_API_KEYS=
# Set to 1 to disable authentication entirely (development only)
#GATEWAY_AUTH_DISABLE=0
# Set to 1 to skip auto-generating an admin key on first boot
#GATEWAY_NO_AUTOBOOTSTRAP=0
# Set to 0 when using dashboard cookie sessions over plain HTTP
#COOKIE_SECURE=1

# --- Rate limiting -----------------------------------------------------------
# Global requests per minute per client
#RATE_LIMIT_RPM=60
# Global burst size
#RATE_LIMIT_BURST=10
# Sliding window duration in seconds
#RATE_LIMIT_WINDOW_SEC=60

# --- Workers / probes --------------------------------------------------------
# Set to 1 to disable background quota-sync worker
#WORKERS_DISABLED=0
# Set to 1 to disable upstream health probes
#HEALTH_PROBES_DISABLED=0

# --- Freebuff upstream -------------------------------------------------------
# Set to 1 to disable the Freebuff provider entirely
#FREEBUFF_DISABLED=0
# Upstream API base URL
#FREEBUFF_API_BASE=https://www.codebuff.com
# User-Agent sent to upstream
#FREEBUFF_USER_AGENT=Freebuff-CLI/0.0.142

# Timeouts (seconds)
#FREEBUFF_UPSTREAM_TIMEOUT=25
#FREEBUFF_SESSION_TIMEOUT=12
#FREEBUFF_NONSTREAM_TIMEOUT=50

# Session / run cache tuning
#FREEBUFF_SESSION_MIN_REMAINING=60
#FREEBUFF_RUN_CACHE_TTL=600

# --- Circuit breaker ---------------------------------------------------------
# Consecutive errors before the circuit opens
#CB_OPEN_THRESHOLD=5
# Seconds the circuit stays open before testing again
#CB_OPEN_DURATION=60
# Probes allowed while half-open
#CB_HALF_OPEN_PROBES=1

# --- Quota sync worker -------------------------------------------------------
# Seconds between quota syncs (default 300 = 5 minutes)
#FB_QUOTA_SYNC_TICK=300
# Startup delay before the first sync (seconds)
#FB_QUOTA_SYNC_STARTUP_DELAY=10

# --- Request body cap --------------------------------------------------------
# Maximum accepted request body in bytes (default 10MB)
#MAX_REQUEST_BODY=10485760

# --- Logging -----------------------------------------------------------------
# debug | info | warning | error
#LOG_LEVEL=info
